<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_mx30_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_mx30_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MX30Companion"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mx30companion" android:host="auth" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.MX30WidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mazda.mx30companion.ACTION_TOGGLE_HVAC" />
                <action android:name="com.mazda.mx30companion.ACTION_LOCK_DOORS" />
                <action android:name="com.mazda.mx30companion.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mx30_widget_info" />
        </receiver>

        <service
            android:name=".tile.MX30ClimateTileService"
            android:exported="true"
            android:icon="@drawable/ic_climate"
            android:label="@string/tile_climate_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
